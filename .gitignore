# Virtual environments
venv/
.venv/

# Runtime data - recordings, database, exports are never committed
data/
*.wav
*.wave
*.flac
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Video - tap-test footage is never committed, same rule as audio. Nor are the
# per-video snippet sidecars the Slice screen writes beside the source file.
*.mp4
*.mov
*.m4v
*.mkv
*.avi
*.webm
*.snippets.json

# Images - third-party reference screenshots kept local only.
# App screenshots for the README get force-added when needed.
*.png
*.jpg
*.jpeg
# ...except the README's own screenshots (regenerate with tools/make_screenshots.py)
!docs/screenshots/
!docs/screenshots/*.png

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
# ...and the report's figures (regenerate with tools/make_report_figures.py)
!docs/report_figures/
!docs/report_figures/*.png
# ...and the final report's figures and photos (tools/make_final_report_figures.py, make_report_diagrams.py)
!docs/final_report_figures/
!docs/final_report_figures/*.png
!docs/final_report_figures/*.jpg
